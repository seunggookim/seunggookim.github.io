% ============================================================
%  cv-mpiea-kim.sty  --  Academic CV style (MPIEA, Kim)
%  Fonts, colours and logo follow letter-mpiea-kim.sty;
%  layout follows the 2025 CV (year column + entries).
%  The body is written by makecv.py; edit cv.yml, not the .tex.
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-mpiea-kim}[2026/11/02 Academic CV style, MPIEA, Kim]

% ---------- Page and fonts ----------
\RequirePackage[a4paper, top=2.5cm, bottom=2.5cm, left=2.2cm, right=2.2cm,
  headsep=1cm, footskip=1.2cm]{geometry}
% XeLaTeX/LuaLaTeX: Helvetica Neue (macOS system font; also has IPA glyphs).
% If it is missing (non-Mac), TeX Gyre Heros (Helvetica clone) is used.
% pdfLaTeX: falls back to helvet (no IPA glyphs).
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{lmodern}
  \RequirePackage{helvet}
  \renewcommand{\familydefault}{\sfdefault}
  \newcommand{\cvlight}{}
  \newcommand{\cvmedium}{\bfseries}
\else
  \RequirePackage{lmodern}      % scalable math fonts (no size warnings)
  \RequirePackage{fontspec}
  \IfFontExistsTF{Helvetica Neue}{%
    \setmainfont{Helvetica Neue}[
      UprightFont = *, BoldFont = * Bold,
      ItalicFont = * Italic, BoldItalicFont = * Bold Italic]
    \newfontfamily\cv@lightfont{Helvetica Neue Light}
    \newfontfamily\cv@mediumfont{Helvetica Neue Medium}
    \newcommand{\cvlight}{\cv@lightfont}
    \newcommand{\cvmedium}{\cv@mediumfont}
  }{%
    \setmainfont{TeX Gyre Heros}
    \newcommand{\cvlight}{}
    \newcommand{\cvmedium}{\bfseries}
  }
  % Hangul (e.g. the name in Korean) via kotex: Apple SD Gothic Neo (macOS),
  % else Noto Sans CJK KR, else kotex's default. Light weight follows \cvlight.
  \RequirePackage{kotex}
  \def\cv@hangul{}%
  \IfFontExistsTF{Apple SD Gothic Neo}{\def\cv@hangul{Apple SD Gothic Neo}}{%
    \IfFontExistsTF{Noto Sans CJK KR}{\def\cv@hangul{Noto Sans CJK KR}}{}}
  \ifx\cv@hangul\empty\else
    \setmainhangulfont{\cv@hangul}[ItalicFont = *, BoldItalicFont = * Bold]
    \ifXeTeX
      % quotes, brackets and punctuation stay in the Latin font
      % (otherwise “ ” come out as wide CJK glyphs)
      \xetexkofontregime{latin}
      \newhangulfontfamily\cv@hlightfont{\cv@hangul}[
        UprightFont = * Light, ItalicFont = * Light, BoldFont = * Bold]
      \expandafter\def\expandafter\cvlight\expandafter{\cvlight\cv@hlightfont}
    \fi
  \fi
\fi
\RequirePackage[nopatch=footnote]{microtype}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{eso-pic}
\RequirePackage{calc}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage[hang,flushmargin]{footmisc}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{xurl}            % break long URLs anywhere
\urlstyle{same}

% ---------- Colours ----------
\definecolor{cv@green}{RGB}{0, 108, 102}
\definecolor{cv@grey}{gray}{0.45}
\definecolor{cv@todo}{RGB}{200, 0, 0}
\hypersetup{colorlinks=true, urlcolor=cv@green, linkcolor=cv@green}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
% keep at least two lines of an entry together; no break right after a heading
\clubpenalty=10000
\widowpenalty=10000
\raggedright

% ---------- Fields set by makecv.py ----------
\newcommand{\cv@footername}{}
\newcommand{\cv@date}{\today}
\newcommand{\cv@runninghead}{Curriculum Vitae}
\newcommand{\cv@logo}{}
\newcommand{\cvset}[2]{\expandafter\renewcommand\csname cv@#1\endcsname{#2}}

% ---------- Header and footer ----------
\fancypagestyle{cv}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyhead[C]{\small\color{cv@grey}\cv@runninghead}%
  \fancyfoot[C]{\small\color{cv@grey}\cv@footername\enspace|\enspace
    \cv@date\enspace|\enspace\thepage\ of \pageref*{LastPage}}%
}
\fancypagestyle{cvfirst}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
}
\pagestyle{cv}

% ---------- Title block (page 1) ----------
% \cvtitle{First}{footnote text}{LAST}{suffix}
\newlength{\cv@logox}
\newcommand{\cvtitle}[4]{%
  \thispagestyle{cvfirst}%
  \ifx\cv@logo\empty\else
    \setlength{\cv@logox}{\paperwidth-1.6cm}%
    \AddToShipoutPictureFG*{\AtPageUpperLeft{%
      \put(\LenToUnit{\cv@logox},\LenToUnit{-3.0cm}){%
        \makebox[0pt][r]{\includegraphics[height=1.8cm]{\cv@logo}}}}}%
  \fi
  \vspace*{1.2cm}%
  {\cvlight\fontsize{30}{36}\selectfont #1\footnote{#2}\ #3}%
  {\cvlight\fontsize{20}{36}\selectfont\ #4}\par
  \vspace{1.0em}%
}

% Contact block: \cvcontact{lines separated by \\}
\newcommand{\cvcontact}[2]{%
  {\large\cvmedium #1\par}%
  \vspace{1pt}%
  {#2\par}%
}

% ---------- Sections ----------
\newcommand{\cvsection}[1]{%
  \par\addvspace{1.4em}%
  {\large\cvmedium #1\par}\nopagebreak
  \vspace{0.15em}\nopagebreak
}
\newcommand{\cvsubsection}[1]{%
  \par\addvspace{0.6em}%
  {\small\itshape #1\par}\nopagebreak
}
% Intro line under a (sub)section heading, e.g. counts or notes
\newcommand{\cvnote}[1]{{\small\itshape #1\par}\nopagebreak}

% ---------- Timeline list: year column + entry ----------
\newlength{\cvlabelwidth}
\setlength{\cvlabelwidth}{2.6cm}
\newlist{cvlist}{description}{1}
\setlist[cvlist]{
  leftmargin=\cvlabelwidth, labelwidth=\cvlabelwidth, labelsep=0pt,
  itemindent=0pt, align=left, font=\normalfont,
  topsep=0pt, partopsep=0pt, parsep=0pt, itemsep=0.55em,
  beginpenalty=10000,
  before=\raggedright
}
\newenvironment{cvcompact}{\begin{cvlist}[itemsep=0.1em]}{\end{cvlist}}
% \cvitem{label}{body}  (use inside cvlist)
\newcommand{\cvitem}[2]{\item[#1]#2}
% detail line under an entry
\newcommand{\cvdetail}[1]{\par{\color{black!80}#1}}

% ---------- Bullets (research interests) ----------
\newlist{cvbullets}{itemize}{1}
\setlist[cvbullets]{label=-, leftmargin=1.2em, topsep=0pt, itemsep=0.1em, parsep=0pt}

% ---------- Referees ----------
\newlist{cvfields}{description}{1}
\setlist[cvfields]{
  leftmargin=\cvlabelwidth, labelwidth=\cvlabelwidth, labelsep=0pt,
  align=left, font=\normalfont, topsep=0pt, itemsep=0pt, parsep=0pt
}
% one referee = one unbreakable block
\newenvironment{cvreferee}[1]{\par\addvspace{0.8em}\noindent\begin{minipage}{\linewidth}\raggedright#1\par}{\end{minipage}\par}

% ---------- Misc ----------
\newcommand{\cvtodo}[1]{{\color{cv@todo}\bfseries [TODO: #1]}}
\newcommand{\cvmark}[1]{\textsuperscript{#1}}
% your own name in author lists (underlined; ulem's \uline can break across lines)
%\RequirePackage[normalem]{ulem}   % normalem: keep \emph as italics
%\newcommand{\cvme}[1]{\uline{#1}}  % unerline

\newcommand{\cvme}[1]{{\cvmedium #1}}

\endinput
