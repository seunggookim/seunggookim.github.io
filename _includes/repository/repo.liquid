{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign repo_label = repo_url.last %}
{% else %}
  {% assign repo_label = include.repository %}
{% endif %}
{% assign info = site.data.repositories.repo_info[include.repository] %}

<div class="repo p-2 w-100">
  <a class="repo-card" href="https://github.com/{{ include.repository }}">
    <div class="repo-card-title">{{ repo_label }}</div>
    {% if info.description %}
      <div class="repo-card-desc">{{ info.description }}</div>
    {% endif %}
    {% if info.language %}
      <div class="repo-card-lang">{{ info.language }}</div>
    {% endif %}
  </a>
</div>
