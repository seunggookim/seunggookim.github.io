<div class="repo p-2 w-100">
  <a class="repo-card repo-card-user" href="https://github.com/{{ include.username }}">
    <img src="https://github.com/{{ include.username }}.png?size=96" alt="{{ include.username }}" width="48" height="48">
    <div>
      <div class="repo-card-title">{{ include.username }}</div>
      <div class="repo-card-desc">github.com/{{ include.username }}</div>
    </div>
  </a>
</div>
