% ============================================================
%  kimcv.sty
%  Academic CV style with repeating header and left-aligned name/title
%  Based on: Dr. Seung-Goo Kim – MPIEA CV style
%
%  Usage in your .tex file:
%    \documentclass[11pt, a4paper]{article}
%    \usepackage{cv-mpiea-kim}
%    \begin{document}
%      \cvheader
%      ...
%    \end{document}
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-mpiea-kim}[Academic CV style, MPIEA, Kim]

% ---------- Dependencies ----------
\RequirePackage[
  top=2.2cm, bottom=2.2cm,
  left=2.3cm, right=2.3cm
]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{helvet}          % Helvetica sans-serif
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage[nopatch=footnote]{microtype}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{setspace}

% ---------- Colours ----------
\definecolor{kl@green}{RGB}{0,108,102}
\definecolor{kl@dark}{RGB}{32,32,32}

% ---------- Hyperlink style ----------
\hypersetup{
  colorlinks = true,
  urlcolor   = kl@green,
  linkcolor  = kl@green,
  citecolor  = kl@green
}

% ---------- Page style ----------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\setlength{\headheight}{32pt}

\fancyhead[L]{%
  \small
  \textbf{\kl@name}\\
  {\color{kl@green}\textbf{\kl@title}}%
}
\fancyhead[R]{%
  \small
  \kl@phone~|~\href{mailto:\kl@email}{\kl@email}\\
  \href{\kl@web}{\kl@web}%
}

% ---------- Document defaults ----------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}
\setlist[itemize]{noitemsep, topsep=0.3em, parsep=0pt, partopsep=0pt}
\setlist[enumerate]{noitemsep, topsep=0.3em, parsep=0pt, partopsep=0pt}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titlespacing*{\section}{0pt}{1.5em}{0.5em}
\titlespacing*{\subsection}{0pt}{1.0em}{0.3em}

% ---------- Defaults (override in your .tex file) ----------
\newcommand{\kl@name}       {Dr. Seung-Goo Kim}
\newcommand{\kl@title}      {Postdoctoral Researcher}
\newcommand{\kl@group}      {Research Group Neurocognition of Music and Language}
\newcommand{\kl@institute}  {Max Planck Institute for Empirical Aesthetics}
\newcommand{\kl@postal}     {Gr\"uneburgweg 14, DE-60322 Frankfurt am Main}
\newcommand{\kl@phone}      {+49\,(0)\,69\,8300\,479\,851}
\newcommand{\kl@email}      {seung-goo.kim@ae.mpg.de}
\newcommand{\kl@web}        {https://seunggookim.github.io}
\newcommand{\kl@logo}       {MPIEA-Logo-Prio1-EN-RGB-green.png}   % optional logo image

% Setter command: \klset{field}{value}
\newcommand{\klset}[2]{%
  \expandafter\renewcommand\csname kl@#1\endcsname{#2}%
}

% ---------- CV header block ----------
\newcommand{\cvheader}{%
  \thispagestyle{fancy}
  \begin{minipage}[t]{0.75\textwidth}
    \raggedright
    {\huge\bfseries \kl@name}\\[4pt]
    {\large\color{kl@green}\bfseries \kl@title}\\[6pt]
    {\small \kl@group}\\
    {\small \kl@institute}
  \end{minipage}
  \hfill
  \begin{minipage}[t]{0.23\textwidth}
    \raggedleft
    {\small \kl@postal}\\[4pt]
    {\small Phone: \kl@phone}\\[2pt]
    {\small Email: \href{mailto:\kl@email}{\kl@email}}\\[2pt]
    {\small Web: \href{\kl@web}{\kl@web}}
  \end{minipage}

  \vspace{0.8em}
  \hrule height 1pt \relax
  \vspace{1.5em}
}

% ---------- Optional logo command ----------
\newcommand{\cvlogo}{%
  \ifx\kl@logo\@empty
    % nothing
  \else
    \begin{flushright}
      \includegraphics[height=1.8cm]{\kl@logo}
    \end{flushright}
  \fi
}

\endinput
