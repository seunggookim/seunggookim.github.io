
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-mpiea-kim}[2026/06/29 Academic CV style]

\RequirePackage[
  a4paper,
  margin=2.2cm,
  top=3.3cm,
  headheight=20mm
]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{tabularx}
\RequirePackage{fancyhdr}
\RequirePackage{helvet}

\renewcommand{\familydefault}{\sfdefault}

\definecolor{MPIEAGreen}{RGB}{0,120,95}

\newcommand{\cvname}{}
\newcommand{\cvposition}{}
\newcommand{\cvinstitute}{}
\newcommand{\cvemail}{}
\newcommand{\cvwebsite}{}
\newcommand{\cvorcid}{}
\newcommand{\cvlogo}{}

\newcommand{\name}[1]{\gdef\cvname{#1}}
\newcommand{\position}[1]{\gdef\cvposition{#1}}
\newcommand{\institute}[1]{\gdef\cvinstitute{#1}}
\newcommand{\email}[1]{\gdef\cvemail{#1}}
\newcommand{\website}[1]{\gdef\cvwebsite{#1}}
\newcommand{\orcidid}[1]{\gdef\cvorcid{#1}}
\newcommand{\logo}[1]{\gdef\cvlogo{#1}}

\newcommand{\makecvheader}{
  \fancyhf{}
  \fancyhead[L]{%
    \begin{tabularx}{0.78\textwidth}{@{}X@{}}
    {\Large\bfseries \cvname}\\
    \cvposition\\
    {\small\cvinstitute}\\[1mm]
    {\small
    \href{mailto:\cvemail}{\cvemail}
    \ifx\cvwebsite\empty\else\quad|\quad\href{\cvwebsite}{\cvwebsite}\fi
    \ifx\cvorcid\empty\else\quad|\quad ORCID: \cvorcid\fi}
    \end{tabularx}
    }
  \fancyhead[R]{%
    \ifx\cvlogo\empty\else
    \includegraphics[height=15mm]{\cvlogo}
    \fi
  }
  \renewcommand{\headrulewidth}{0pt}
  \fancyfoot[C]{}
  \fancyfoot[R]{\thepage}
  \pagestyle{fancy}
  \vspace*{-0.5\baselineskip}
  {\color{MPIEAGreen}\rule{\textwidth}{0.8pt}}
  \vspace{0.7\baselineskip}
}

\newcommand{\cvsection}[1]{%
  \vspace{1.2\baselineskip}%
  {\Large\bfseries\color{MPIEAGreen}#1\par}
  \vspace{2pt}
  {\color{MPIEAGreen}\rule{\textwidth}{0.5pt}}
  \vspace{0.5\baselineskip}
}

\newcommand{\cventry}[4]{%
  \noindent
  \begin{tabularx}{\textwidth}{@{}p{2.8cm}X@{}}
  \textbf{#1} &
  \textbf{#2}\\
  & #3\\
  & #4\\[0.5\baselineskip]
  \end{tabularx}
}
